  hideHandBeforeIntro: 1
  hideHandAfterIntro: 1
  introLines:
  - text: "\u041D\u0435 \u0434\u0435\u0440\u0433\u0430\u0439\u0441\u044F. \u042F
      \u043D\u0435 \u0437\u0430 \u043D\u0438\u043C\u0438."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u043B\u0435\u043F\u0430\u044F. \u041D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u042F \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F. \u041D\u043E \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u044B \u0434\u0435\u0442\u0430\u043B\u0438."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u041E\u0442\u0434\u0430\u0432\u0430\u0439 \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
      \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u043C\u0435\u0440\u0430 \u043D\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442. \u042F \u0443\u043C\u0435\u044E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u042F \u0431\u0443\u0434\u0443 \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u0442\u044C
      \u043F\u0438\u0442\u0430\u043D\u0438\u0435. \u0412 \u044D\u0442\u0438 \u043E\u043A\u043D\u0430
      \u043A\u0430\u043C\u0435\u0440\u0430 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0439 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0435\u0442\u0441\u044F,
      \u043E\u043D\u0438 \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u044F\u0442
      \u0432\u0441\u0435."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 0
  - text: "\u0414\u0435\u0440\u0436\u0438. \u042D\u0442\u043E \u043E\u0442 \u043A\u0435\u0439\u0441\u0430
      \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
    holdTime: 1.6
    voiceBlips: []
    blipInterval: 0.055
    giveKeyAfterThisLine: 1
