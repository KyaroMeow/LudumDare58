  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1bee49c0cbd646ea8a46907320d01c89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneImage: {fileID: 1854159691}
  fadeBlackImage: {fileID: 1550591855}
  dialogText: {fileID: 681169466}
  audioSource: {fileID: 751715227}
  choicePanel: {fileID: 634552777}
  cutsceneSteps:
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: 20bef36195a948d4e918a1d5ea9c9f13, type: 3}
    subtitle: "\u0425\u0435\u0439, \u0442\u044B! \u0421\u0442\u043E\u0439! \u043D\u0435
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439 \u044D\u0442\u043E \u0432
      \u0431\u0440\u0430\u043A!"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: c18920eaea17f9644a6862cabc62b8a6, type: 3}
    subtitle: "\u042D\u0442\u043E \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043D\u0443\u0436\u043D\u043E, \u043E\u0447\u0435\u043D\u044C \u043E\u0447\u0435\u043D\u044C"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: 822821e943fea3841b47986043083ea8, type: 3}
    subtitle: "\u042F \u0438\u0441\u043A\u0430\u043B \u044D\u0442\u043E \u0443\u0436\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442 \u0442\u0443\u0442"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: a61a39e582656e4468abcdd16872fe01, type: 3}
    subtitle: "\u0422\u0435\u0431\u0435 \u043D\u0430\u0432\u0435\u0440\u043D\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0442\u043E
      \u044F?"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: 96a3b589a45494144ba255f0de4bb48a, type: 3}
    subtitle: "... \u042F..\u044F.\u044F \u0431\u0435\u0433\u043B\u0435\u0446"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: 1183f5f70f09be741befab283529a93e, type: 3}
    subtitle: "\u0412\u043E\u0442 \u0443\u0436\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u044F
      \u0438\u0449\u0443 \u044D\u0442\u043E\u0442 \u043A\u0443\u0431"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  - image: {fileID: 0}
    audioClip: {fileID: 8300000, guid: ed8d2cbf8b1e6f4449ffe3d703b4a0bf, type: 3}
    subtitle: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u043E\u0448\u0443,
      \u0443\u043C\u043E\u043B\u044F\u044E! \u041E\u0442\u0434\u0430\u0439 \u043C\u043D\u0435
      \u0435\u0433\u043E"
    autoAdvanceDuration: 0
    subtitleDuration: 0
    fadeDuration: 0
  skipCutscene: 0
